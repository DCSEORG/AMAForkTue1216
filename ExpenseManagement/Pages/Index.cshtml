@page
@model ExpenseManagement.Pages.IndexModel
@{
    ViewData["Title"] = "Expenses";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Expenses</h2>
        </div>
        <div class="card-body">
            <form method="get" class="mb-4">
                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text">Filter:</span>
                            <input type="text" class="form-control" name="filter" value="@Model.Filter" placeholder="Search by category, description, or status" />
                            <button type="submit" class="btn btn-primary">Search</button>
                            @if (!string.IsNullOrEmpty(Model.Filter))
                            {
                                <a href="/Index" class="btn btn-secondary">Clear</a>
                            }
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        <a href="/AddExpense" class="btn btn-success">+ Add Expense</a>
                    </div>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Expenses != null && Model.Expenses.Any())
                        {
                            @foreach (var expense in Model.Expenses)
                            {
                                <tr>
                                    <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                    <td>@expense.CategoryName</td>
                                    <td>£@expense.Amount.ToString("N2")</td>
                                    <td>
                                        @if (expense.StatusName == "Approved")
                                        {
                                            <span class="badge bg-success">@expense.StatusName</span>
                                        }
                                        else if (expense.StatusName == "Rejected")
                                        {
                                            <span class="badge bg-danger">@expense.StatusName</span>
                                        }
                                        else if (expense.StatusName == "Submitted")
                                        {
                                            <span class="badge bg-warning text-dark">@expense.StatusName</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@expense.StatusName</span>
                                        }
                                    </td>
                                    <td>@expense.Description</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">No expenses found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Expenses != null && Model.Expenses.Any())
            {
                <div class="mt-3">
                    <button type="button" class="btn btn-primary">Save</button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .table th {
        font-weight: 600;
        border-bottom: 2px solid #dee2e6;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }
    
    .btn-primary:hover {
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    }
</style>
