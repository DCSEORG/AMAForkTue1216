@page
@model ExpenseManagement.Pages.AddExpenseModel
@{
    ViewData["Title"] = "Add Expense";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Expense Management System</h2>
        </div>
        <div class="card-body">
            <h3 class="mb-4">Add Expense</h3>
            
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Model.Message
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Amount:</label>
                    <div class="input-group">
                        <span class="input-group-text">£</span>
                        <input type="number" step="0.01" class="form-control" name="Amount" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Date:</label>
                    <input type="date" class="form-control" name="ExpenseDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Category:</label>
                    <select class="form-select" name="CategoryId" required>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryId" selected="@(category.CategoryName == "Travel")">
                                @category.CategoryName
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Description:</label>
                    <textarea class="form-control" name="Description" rows="4" placeholder="Enter expense description"></textarea>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-5">Submit</button>
                    <a href="/Index" class="btn btn-secondary px-5">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .card-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .form-label {
        font-size: 1rem;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }
    
    .btn-primary:hover {
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    }
    
    .card {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
</style>
